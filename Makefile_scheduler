# Makefile for scheduler (scheduler.c, dispatch.c, painter.c)
#
# Usage:
#   make -f Makefile_scheduler        # compile
#   make -f Makefile_scheduler run    # compile and run
#            -D MAIN_LOG=1 -DWORKER_LOG=1 \

CC       := cc
CFLAGS   := -g -std=c11 -Wall -O2 \
            -I esl_proxy/include \
            -Wno-macro-redefined \
            -D_GNU_SOURCE \
            -DWORKER_LOG=1 -DLOG_OUTPUT_MODE=0

# EARLY_DISPATCH=1 enables Case B (plant a successor behind an already-executing predecessor).
# EARLY_DISPATCH_CASE_A=1 additionally enables Case A (co-dispatch onto a fully idle core).
# Both off by default, so the baseline is reachable for comparison and as a negative control.
ifeq ($(EARLY_DISPATCH),1)
CFLAGS   += -DEARLY_DISPATCH
endif
ifeq ($(EARLY_DISPATCH_CASE_A),1)
CFLAGS   += -DEARLY_DISPATCH -DEARLY_DISPATCH_CASE_A
endif

# SIM_LATENCY=1 replaces the fake return (task retires the round after it is sent) with an
# in-order 2-slot arbiter that holds a core for SIM_TICKS rounds. Required to observe any
# multi-round behaviour, including early dispatch. SIM_TICKS overrides the default duration.
ifeq ($(SIM_LATENCY),1)
CFLAGS   += -DSIM_LATENCY
endif
ifneq ($(SIM_TICKS),)
CFLAGS   += -DSIM_TICKS=$(SIM_TICKS)
endif

UNAME_S  := $(shell uname -s)
ifeq ($(UNAME_S),Linux)
    LDFLAGS  := -lpthread -latomic
else
    LDFLAGS  := -lpthread
endif

BIN_DIR  := bin
TARGET   := $(BIN_DIR)/scheduler_test

SRCS := \
    esl_proxy/src/scheduler/scheduler.c \
    esl_proxy/src/scheduler/dispatch.c \
    esl_proxy/src/scheduler/painter.c \
    esl_proxy/src/scheduler/log.c

OBJS := $(patsubst esl_proxy/src/scheduler/%.c,$(BIN_DIR)/scheduler/%.o,$(SRCS))

.PHONY: all run clean

all: $(TARGET)

$(TARGET): $(OBJS) | $(BIN_DIR)
	$(CC) $(CFLAGS) $(OBJS) -o $@ $(LDFLAGS)

$(BIN_DIR)/scheduler/%.o: esl_proxy/src/scheduler/%.c | $(BIN_DIR)/scheduler
	$(CC) $(CFLAGS) -c $< -o $@

$(BIN_DIR) $(BIN_DIR)/scheduler:
	mkdir -p $@

run: all
	$(TARGET)

clean:
	rm -rf $(BIN_DIR)/scheduler $(TARGET)